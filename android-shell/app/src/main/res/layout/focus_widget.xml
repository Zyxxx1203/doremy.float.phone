<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/focus_widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/focus_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="专注 · FOCUS"
        android:textSize="12sp"
        android:textColor="#8B97AD"
        android:letterSpacing="0.12" />

    <Chronometer
        android:id="@+id/focus_widget_chrono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:fontFamily="monospace"
        android:textColor="#E8ECF5"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/focus_widget_paused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="34sp"
        android:fontFamily="monospace"
        android:textColor="#5F6B80"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:id="@+id/focus_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:progressDrawable="@drawable/focus_widget_progress" />

    <TextView
        android:id="@+id/focus_widget_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#E8ECF5"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/focus_widget_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8B97AD"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />
</LinearLayout>
